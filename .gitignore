dist/

# .env staat bewust WEL in de repo: de Supabase-URL en de publishable key
# horen in de browser en zijn niet geheim. .env.local blijft lokaal, voor als
# je tijdelijk naar een andere Supabase-instantie wilt wijzen.
.env.local
.env.*.local

# Secrets van de Edge Function (VAPID private key, CRON_SECRET). Die WEL
# geheim zijn. Zet ze in Supabase met `supabase secrets set --env-file`.
supabase/functions/.env
# Eenmalig samengevoegde versie om in de dashboardeditor te plakken.
supabase/functions/send-reminders-dashboard.ts
# Lokale toestand van de Supabase CLI
supabase/.temp/
*.log
.DS_Store
.vscode/
.idea/

